<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Streaming</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            padding: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 15px;
            text-align: left;
        }

        h1 {
            color: #333;
            margin-top: 50px;
            margin-bottom: 10px;
        }

        .camera-control {
            margin-bottom: 15px;
        }

        input[type="checkbox"] {
            margin-right: 10px;
        }

        input[type="number"] {
            width: 60px;
        }

        button {
            padding: 10px 15px;
            background-color: #4CAF50;
            color: white;
            border: none;
            cursor: pointer;
        }

        button:hover {
            background-color: #45a049;
        }
    </style>
</head>
<body>
<h1>Camera Result</h1>
<table>
    <tr>
        <th>Link</th>
        <th>Video</th>
    </tr>
    <tr>
        <td>
            for image: <a href="/image?source=display_capture">/image?source=display_capture</a><br>
            for video: <a href="/video?source=display_capture">/video?source=display_capture</a>
        </td>
        <td><img src="{{ url_for('get_video') }}" width="300" alt="Display Capture"></td>
    </tr>
    {% for i in range(camera_states|length) %}
    <tr>
        <td>
            for image: <a href="/image?source=video_capture&id={{ i }}">/image?source=video_capture&id={{ i }}</a><br>
            for video: <a href="/video?source=video_capture&id={{ i }}">/video?source=video_capture&id={{ i }}</a>
        </td>
        <td><img src="{{ url_for('get_video') }}?source=video_capture&id={{ i }}" width="300" alt="Video Capture"></td>
    </tr>
    {% endfor %}
</table>

</body>
</html>